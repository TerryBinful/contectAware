{
  "experiment": "post-pivot decision-layer mechanism comparison",
  "version": "v1",
  "research_question": "Under a common authentication-score generator and matched operating conditions, how do alternative temporal decision-layer stabilization mechanisms differ in security, temporal decision stability, and responsiveness during identity transitions?",
  "dataset": {"name": "ExtraSensory primary feature files", "participants": 60, "observations": 377346,
    "features": 225, "cadence": "~1 observation/minute (measured)", "committed_to_repo": false,
    "source": "http://extrasensory.ucsd.edu/data/primary_data_files/ExtraSensory.per_uuid_features_labels.zip",
    "md5_zip": "9e44b3484b74cd8a370ff22894e0899b"},
  "participants": {"cohort": "regular cadence >=95% gaps in 59-61s and >=1500 frames", "n_eligible": 31,
    "split": "chronological 60/20/20 per user", "impostor_pools": "disjoint fit(24)/calibration(12)/test(24)",
    "manifest": "results/mechanism_comparison/manifests/participant_split.json"},
  "features": {"primary": "F3_NO_LOC_NO_DEVSTATE", "secondary": "F1_ALL",
    "rationale": "Stage 2 ablation: excluding location/device-state changed AUC 0.998 -> 0.997"},
  "classifier": {"role": "fixed authentication-score generator", "model": "GradientBoostingClassifier",
    "raw_score": "decision_function (log-odds)", "normalisation": "ECDF fitted on calibration scores only",
    "per_enrolled_user": true, "resampling": "none (sample weights)"},
  "mechanisms": ["instantaneous", "moving_average", "ewma", "majority_vote", "debounce",
                 "margin_dual_threshold", "hysteresis", "trust_model", "sprt"],
  "temporal_units": "frames (1 frame ~ 1 minute); TTT=3s not used",
  "benchmark": {"structure": "genuine 60 | impostor 60 | recovery 60 frames", "contiguous_blocks_only": true,
    "splices_recorded": true, "interpolation": "none", "sequences_per_user": 6},
  "operating_point": {"method": "matched calibration frame-level FAR", "target": 0.05, "tolerance": 0.01,
    "tie_break": ["lower calibration FRR", "simpler parameters"], "test_data_used_for_tuning": false},
  "metrics": {"security": ["FAR", "FRR", "false_accept_frames", "false_reject_frames"],
    "stability": ["n_transitions", "transition_rate_per_100", "n_flip_events", "mean_run_length_frames"],
    "responsiveness": ["detection_latency_frames", "recovery_latency_frames", "lockout_fraction_during_genuine"]},
  "statistics": {"unit": "enrolled user", "test": "paired Wilcoxon signed-rank vs instantaneous baseline",
    "correction": "Holm", "uncertainty": "bootstrap 95% CI"},
  "seeds": {"config_seed": 20260918},
  "outputs": {"root": "results/mechanism_comparison",
    "files": ["mechanism_metrics.csv", "participant_metrics.csv", "sequence_metrics.csv",
              "transition_metrics.csv", "statistical_tests.csv", "operating_points.csv",
              "score_generator_manifest.csv", "benchmark/sequence_manifest.csv",
              "experiment_metadata.json", "figures/", "tables/", "logs/"]},
  "commands": {"run": "python scripts/run_mechanism_comparison.py --config configs/mechanism_comparison.json --data <csv_dir> --out results/mechanism_comparison",
               "analyse": "python scripts/analyse_mechanism_comparison.py --out results/mechanism_comparison",
               "tests": "python tests/test_mechanisms.py"}
}
